# Smart Factory Digital Twin - Environment Configuration
# Default configuration matches the Docker PostgreSQL container (docker compose up -d)

# PostgreSQL Connection Settings
DB_URL=jdbc:postgresql://localhost:5432/smart_factory
DB_USER=postgres
DB_PASSWORD=postgres

# Connection Pool Settings (Optional)
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=5000
